<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_jalali" model="ir.ui.view">
        <field name="name">res.users.form.jalali.toggle</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lang']" position="after">
                <field name="use_jalali_calendar" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_jalali_simple" model="ir.ui.view">
        <field name="name">res.users.form.simple.jalali.toggle</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lang']" position="after">
                <field name="use_jalali_calendar" widget="boolean_toggle" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>
