<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_erp_auto" model="ir.module.category">
        <field name="name">اتوماسیون حساب‌یار</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_erp_auto_user" model="res.groups">
        <field name="name">کاربر اتوماسیون</field>
        <field name="category_id" ref="module_category_erp_auto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_erp_auto_manager" model="res.groups">
        <field name="name">مدیر اتوماسیون</field>
        <field name="category_id" ref="module_category_erp_auto"/>
        <field name="implied_ids" eval="[(4, ref('group_erp_auto_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_approval_company" model="ir.rule">
        <field name="name">صف تأیید: چندشرکتی</field>
        <field name="model_id" ref="model_erp_auto_approval"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_audit_company" model="ir.rule">
        <field name="name">لاگ حسابرسی: چندشرکتی</field>
        <field name="model_id" ref="model_erp_auto_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_job_company" model="ir.rule">
        <field name="name">کار خودکار: چندشرکتی</field>
        <field name="model_id" ref="model_erp_auto_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
