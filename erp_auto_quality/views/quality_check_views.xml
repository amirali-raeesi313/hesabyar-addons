<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_check_list" model="ir.ui.view">
        <field name="name">erp.auto.quality.check.list</field>
        <field name="model">erp.auto.quality.check</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'passed'"
                  decoration-danger="state in ('failed','quarantine')"
                  decoration-warning="state == 'to_check'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <field name="quantity"/>
                <field name="measure_value" invisible="measure_type != 'quantitative'"/>
                <field name="inspector_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"/>
                <field name="measure_type" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_quality_check_form" model="ir.ui.view">
        <field name="name">erp.auto.quality.check.form</field>
        <field name="model">erp.auto.quality.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pass" type="object" string="قبول"
                            class="btn-success" invisible="state in ('passed',)"/>
                    <button name="action_fail" type="object" string="رد"
                            class="btn-danger" invisible="state in ('failed','quarantine')"/>
                    <button name="action_evaluate" type="object" string="ارزیابی خودکار"
                            invisible="measure_type != 'quantitative'"/>
                    <button name="action_open_alert" type="object" string="عدم انطباق"
                            invisible="not alert_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="point_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                            <field name="partner_id"/>
                            <field name="inspector_id"/>
                            <field name="check_date"/>
                            <field name="measure_type" invisible="1"/>
                            <field name="alert_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="اندازه‌گیری" invisible="measure_type != 'quantitative'">
                        <field name="measure_value"/>
                        <field name="spec_min"/>
                        <field name="spec_max"/>
                    </group>
                    <group string="توضیح">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_quality_check_search" model="ir.ui.view">
        <field name="name">erp.auto.quality.check.search</field>
        <field name="model">erp.auto.quality.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="to_check" string="در انتظار بازرسی"
                        domain="[('state','=','to_check')]"/>
                <filter name="quarantine" string="قرنطینه"
                        domain="[('state','=','quarantine')]"/>
                <group expand="0" string="گروه‌بندی">
                    <filter name="g_state" string="وضعیت" context="{'group_by':'state'}"/>
                    <filter name="g_product" string="کالا" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_quality_check" model="ir.actions.act_window">
        <field name="name">بازرسی‌های کیفیت</field>
        <field name="res_model">erp.auto.quality.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_check': 1}</field>
    </record>
</odoo>
