<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_stale_quotes" model="ir.cron">
        <field name="name">حساب‌یار: پیگیری پیش‌فاکتورهای راکد</field>
        <field name="model_id" ref="model_erp_auto_flows"/>
        <field name="state">code</field>
        <field name="code">model._cron_stale_quotes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_expiry_alerts" model="ir.cron">
        <field name="name">حساب‌یار: هشدار کالاهای نزدیک انقضا</field>
        <field name="model_id" ref="model_erp_auto_flows"/>
        <field name="state">code</field>
        <field name="code">model._cron_expiry_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
